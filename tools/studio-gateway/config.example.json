{
  "host": "127.0.0.1",
  "port": 8080,
  "backend_port": 18080,
  "default_model": "swift-1.5",
  "idle_seconds": 1800,
  "max_parked": 4,
  "memory_reserve_gib": 6,
  "cache_root": "~/Library/Caches/TensorFold/studio-gateway",
  "allowed_hosts": [],
  "key_files": [
    {
      "label": "owner",
      "path": "~/.config/tensorfold/api-key"
    },
    {
      "label": "guest",
      "path": "~/.config/tensorfold/api-key.guest",
      "required": false
    }
  ],
  "models": [
    {
      "id": "swift-1.5",
      "memory_required_gib": 45.5,
      "env": {"TF_PROMPT_ROWS": "128"},
      "argv": [
        "~/ai/tensorfold-gateway/TensorFold/zig-out/native/bin/tensorfold-native",
        "serve",
        "~/ai/models/swift-1.5-native-vision-b4c84d42",
        "--name", "swift-1.5",
        "--vision", "--vision-image-tokens", "2048", "--vision-max-images", "2",
        "--vision-video-tokens", "2048", "--vision-max-videos", "1",
        "--context", "131072",
        "--parallel", "1",
        "--prompt-cache-gib", "9",
        "--prompt-cache-over-cap",
        "--snapshot-dir", "none",
        "--learn-conversations",
        "--learn-dir", "{snapshot_dir}/bootstrap",
        "--learn-gib", "1",
        "--learn-daily-gib", "1",
        "--drafter", "~/ai/drafters/Qwen3.8-27B-DFlash2",
        "--drafter-bits", "4",
        "--api-key-file", "{backend_key_file}",
        "--host", "127.0.0.1",
        "--port", "{backend_port}"
      ]
    },
    {
      "id": "arete-27b",
      "memory_required_gib": 44,
      "aliases": ["arete-27b-5bit"],
      "env": {"TF_PROMPT_ROWS": "128"},
      "argv": [
        "~/ai/tensorfold-gateway/TensorFold/zig-out/native/bin/tensorfold-native",
        "serve",
        "~/ai/models/arete-27b-mlx-5bit-108f0afb",
        "--name", "arete-27b",
        "--vision", "--vision-image-tokens", "2048", "--vision-max-images", "2",
        "--vision-video-tokens", "2048", "--vision-max-videos", "1",
        "--context", "131072",
        "--parallel", "1",
        "--prompt-cache-gib", "9",
        "--prompt-cache-over-cap",
        "--snapshot-dir", "none",
        "--learn-conversations",
        "--learn-dir", "{snapshot_dir}/bootstrap",
        "--learn-gib", "1",
        "--learn-daily-gib", "1",
        "--drafter", "~/ai/drafters/Qwen3.8-27B-DFlash2",
        "--drafter-bits", "4",
        "--api-key-file", "{backend_key_file}",
        "--host", "127.0.0.1",
        "--port", "{backend_port}"
      ]
    }
  ]
}
